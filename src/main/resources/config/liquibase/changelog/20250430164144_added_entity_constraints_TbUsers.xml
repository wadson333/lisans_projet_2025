<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity TbUsers.
    -->
    <changeSet id="20250430164144-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="tb_addresses_id"
                                 baseTableName="tb_users"
                                 constraintName="fk_tb_users__tb_addresses_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tb_addresses"
                                 />

        <addForeignKeyConstraint baseColumnNames="tb_users_id"
                                 baseTableName="rel_tb_users__roles"
                                 constraintName="fk_rel_tb_users__roles__tb_users_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tb_users"
                                 />

        <addForeignKeyConstraint baseColumnNames="roles_id"
                                 baseTableName="rel_tb_users__roles"
                                 constraintName="fk_rel_tb_users__roles__roles_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tb_roles"
                                 />
    </changeSet>
</databaseChangeLog>
